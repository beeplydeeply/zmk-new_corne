#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default {
            display-name = "QWERTY";
            bindings = <
&kp ESCAPE      &kp Q        &kp W        &kp E        &kp R        &kp T                         &kp UP               &kp Y      &kp U  &kp I      &kp O    &kp P          &kp BSPC
&kp TAB         &mt LC(A) A  &mt LC(S) S  &mt LC(D) D  &mt LC(F) F  &kp G               &kp LEFT  &kp F22   &kp RIGHT  &kp H      &kp J  &kp K      &kp L    &kp SEMICOLON  &kp SQT
&kp LEFT_SHIFT  &mt LC(Z) Z  &mt LC(X) X  &mt LC(C) C  &mt LC(V) V  &kp B      &to 3              &kp DOWN             &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH       &kp RIGHT_SHIFT
                                          &kp LCTRL    &mo 1        &kp SPACE                                          &kp ENTER  &mo 2  &kp RALT
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        num {
            display-name = "NUMBER";
            bindings = <
&kp GRAVE       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp N4  &kp N5                                   &mmv MOVE_UP                     &kp NUMBER_6  &kp N7        &kp N8            &kp N9             &kp N0         &kp BSPC
&kp TAB         &none         &none         &none         &none   &none                    &mmv MOVE_LEFT  &kp F22         &mmv MOVE_RIGHT  &kp MINUS     &kp EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp PG_UP
&kp LEFT_SHIFT  &none         &none         &none         &none   &none      &kp C_MUTE                    &mmv MOVE_DOWN                   &kp EXCL      &kp QUESTION  &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp SLASH      &kp PG_DN
                                            &trans        &trans  &kp SPACE                                                                 &kp ENTER     &none         &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1     &kp F2      &kp F3     &kp F4       &kp F5     &kp F6                                   &mmv MOVE_UP                     &kp F7       &kp F8     &kp F9       &kp F10     &kp F11          &kp F12
&trans     &trans      &mkp LCLK  &mkp MCLK    &mkp RCLK  &mkp MB4                 &mmv MOVE_LEFT  &kp F22         &mmv MOVE_RIGHT  &bootloader  &mkp LCLK  &mkp MCLK    &mkp RCLK   &kp PRINTSCREEN  &kp F12
&kp LCTRL  &sys_reset  &trans     &bootloader  &trans     &mkp MB5   &kp C_MUTE                    &mmv MOVE_DOWN                   &trans       &trans     &bootloader  &sys_reset  &kp SCROLLLOCK   &kp PAUSE_BREAK
                                  &trans       &trans     &kp SPACE                                                                 &kp ENTER    &trans     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        pso {
            bindings = <
&kp ESCAPE  &mt LC(NUMBER_1) NUMBER_1  &mt LC(NUMBER_2) NUMBER_2  &mt LC(NUMBER_3) NUMBER_3  &mt LC(NUMBER_4) NUMBER_4  &mt LC(N5) N5                   &trans           &mt RC(NUMBER_6) NUMBER_6  &mt RC(N7) N7  &mt RC(N8) N8  &mt RC(N9) N9  &mt RC(N0) N0  &trans
&kp TAB     &trans                     &trans                     &trans                     &trans                     &trans                  &trans  &kp F22  &trans  &trans                     &trans         &trans         &trans         &trans         &trans
&none       &trans                     &trans                     &trans                     &trans                     &trans         &to 0            &trans           &trans                     &trans         &trans         &trans         &trans         &trans
                                                                  &trans                     &trans                     &kp SPACE                                        &trans                     &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };
    };
};
